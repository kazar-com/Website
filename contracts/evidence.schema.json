{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "asset_record_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "enum": [
        "site_photo",
        "construction_detail",
        "drawing",
        "mock_up",
        "sample",
        "designer_render",
        "coordination_record",
        "execution_record",
        "acceptance_record"
      ]
    },
    "date_revision": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "date",
        "revision"
      ]
    },
    "evidence_status": {
      "enum": [
        "PROPOSED",
        "DOCUMENTED DECISION",
        "EXECUTED",
        "ACCEPTED"
      ]
    },
    "kazar_role": {
      "type": "string",
      "minLength": 1
    },
    "architect_designer_credit": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "claim_supported": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "publication_permission": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "approved",
        "record_id",
        "scope",
        "channels"
      ]
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_review_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "alt_text": {
      "type": "string",
      "minLength": 1
    },
    "asset_path": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "acceptance_record": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "record_id",
            "scope",
            "date"
          ]
        }
      ]
    },
    "stage_links": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "stage": {
            "enum": [
              "01 DEFINE",
              "02 RESOLVE",
              "03 COORDINATE",
              "04 CONTROL",
              "05 APPROVE",
              "06 BUILD",
              "07 VERIFY",
              "08 HANDOVER & CARE"
            ]
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "const": "relevant_to"
          }
        },
        "required": [
          "stage",
          "record_id",
          "relationship"
        ]
      }
    }
  },
  "required": [
    "project",
    "asset_record_id",
    "evidence_type",
    "date_revision",
    "evidence_status",
    "kazar_role",
    "architect_designer_credit",
    "source",
    "claim_supported",
    "scope",
    "publication_permission",
    "verified_by",
    "last_review_date",
    "alt_text",
    "asset_path",
    "supersedes",
    "acceptance_record",
    "stage_links"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_status": {
            "const": "ACCEPTED"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_record": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_type": {
            "const": "designer_render"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_status": {
            "const": "PROPOSED"
          }
        }
      }
    }
  ]
}